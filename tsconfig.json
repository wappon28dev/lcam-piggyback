{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "@cloudflare/workers-types",
      "bun"
    ],
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "*.config.ts"
  ]
}
